# Docker ignore file for GMAT Quiz Application

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git/
.gitignore

# Docker files (exclude from individual container builds)
Dockerfile
Dockerfile.frontend
Dockerfile.backend
docker-compose.yml
.dockerignore

# Environment files
.env
.env.local
.env.development
.env.test
.env.production

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Backup files
Backup/
Temp/

# Windows batch files (not needed in Docker)
*.bat

# Documentation
README.md
DOCKER-README.md
QUICK-START.md

# Testing
.pytest_cache/
.coverage
htmlcov/

# Node modules (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
